# 复制此文件为 .env 并填入你自己的配置（.env 已被 .gitignore 忽略）
VLM_API_KEY=
DEEPSEEK_API_KEY=
DIRECT_DEEPSEEK_API_KEY=
VLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VLM_MODEL=qwen3.8-flash

# API 与 Cockpit 服务安全配置（默认仅监听本机回环地址）
ROBOT_API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8000
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=5000
COCKPIT_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# SSH 隧道配置（切勿在源码中硬编码服务器地址或密码）
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
SSH_KEY_PATH=
SSH_KNOWN_HOSTS=
SSH_TRUST_NEW_HOST=0
SSH_LOCAL_PORT=6006
SSH_REMOTE_HOST=127.0.0.1
SSH_REMOTE_PORT=6006
